# Copiar a .env y completar en cada máquina. No commitear .env.
# Los valores de abajo son marcadores de posición, no credenciales reales.

# PostgreSQL local (docker-compose.yml) o cadena de Neon.
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio_capilar
DATABASE_URL_TEST=postgresql://studio:studio@localhost:5432/studio_capilar_test

# Secreto para firmar JWT. Usar una cadena larga y aleatoria. No reutilizar este texto.
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

PORT=4000
# Origen del frontend. En local es Vite. En Netlify, la URL pública del sitio.
CORS_ORIGIN=http://localhost:5173

# Único administrador de la v1. Lo crea `npm run seed` si todavía no existe.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@studio-capilar.local
ADMIN_PASSWORD=cambiar-por-una-contrasena

# Opcional. Si está definido, el seed crea datos de demostración.
# DEMO_PASSWORD=cambiar-por-una-contrasena

# Solo el frontend. URL pública del backend. Vacío en local: Vite proxea /api.
VITE_API_URL=
